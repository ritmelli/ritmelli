__pycache__/
*.pyc
.venv*/
dev/.venv*/

# os dados de quem usa moram em %LOCALAPPDATA%\Ritmelli (pastas.py); a library/ fica aqui
# so para nunca subir audio de uma versao antiga. Os logs/ sao os do dev/ (logs/efeitos/:
# a voz de quem grava)
library/
logs/

# ffmpeg, ffprobe e deno que o app usa no lugar dos do PATH (pastas.py): no app, o instalador poe
/bin/

# o que o PyInstaller gera (ritmelli.spec)
build/
dist/

# o que o instalador/monta.ps1 baixa e gera
instalador/vendor/
instalador/saida/

# os modelos do pedal de troca de voz (pistavoz.py), do ritmelli-voices: no app, o instalador baixa; pelo codigo, o
# python dev/vozes.py baixa
/vozes/

# optional local modules that are not part of the app (ritmelli.spec excludes them from the build)
/mina.py
/fim.py
/lucy_voz.py
